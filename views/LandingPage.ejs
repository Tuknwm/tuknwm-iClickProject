<%- include('partials/header.ejs') %>


<div class="KotakTeksLP" id="lp-title">
  <h1 class="TeksAnimLP active">Modern Clicking Counter</h1>
  <h1 class="TeksAnimLP">Challenge Yourself</h1>
</div>
<p id="lp-sub">Know your limit at clicking, with saving point features.</p>

<div class="KotakOpsiLogin" id="lp-buttons">
  <div class="KotakRegister">
    <button class="RegisterButton" onclick="window.location.href='/register'">Register</button>
  </div>
  <div class="KotakLogin">
    <button class="LoginButton" onclick="window.location.href='/login'">Login</button>
  </div>
</div>

<p class="TeksGuest" id="lp-guest-text">Want To Play Without Account?</p>
<div class="KotakGuest" id="lp-guest-btn">
  <button class="GuestButton" onclick="window.location.href='/home'">Play As Guest</button>
</div>

<!-- One-time dummy notice popup -->
<div id="dummy-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:10000;align-items:center;justify-content:center;">
  <div style="background:#1a1a1a;color:#fff;border:1px solid #444;border-radius:12px;padding:32px 28px;max-width:380px;width:90%;text-align:center;font-family:'Montserrat',sans-serif;display:flex;flex-direction:column;align-items:center;gap:14px;">
    <h2 style="margin:0;font-size:1.2rem;letter-spacing:.04em;">⚠️ Heads Up!</h2>
    <p style="margin:0;font-size:.88rem;line-height:1.6;color:#ccc;transform:none;">
      This website is a <strong style="color:#fff;">dummy / demo project</strong> that has been around for a while.<br>
      Some features may no longer work as this project is no longer actively maintained.
    </p>
    <button id="dummy-close" style="background:#fff;color:#111;border:none;border-radius:8px;padding:10px 28px;font-size:.9rem;font-weight:600;cursor:pointer;font-family:inherit;">Got it</button>
  </div>
</div>

<script src="/js/AnimTeks.js"></script>
<script>
  if (!sessionStorage.getItem('dummy-noticed')) {
    document.addEventListener('loadingDone', () => {
      setTimeout(() => {
        document.getElementById('dummy-overlay').style.display = 'flex';
      }, 500);
    }, { once: true });
  }
  document.getElementById('dummy-close').addEventListener('click', () => {
    sessionStorage.setItem('dummy-noticed', '1');
    document.getElementById('dummy-overlay').style.display = 'none';
  });
</script>
